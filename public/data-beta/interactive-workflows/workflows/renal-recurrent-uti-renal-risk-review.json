    {
      "workflow_id": "renal-recurrent-uti-renal-risk-review",
      "evidence_statement_id": "wave8-renal-recurrent-uti-renal-risk-review--generated-0002",
      "source_id": "dha-dysuria-issue2-2024",
      "exact_locator": {
        "section_id": "dha-dysuria-v2-history",
        "heading": "Clinical history for dysuria",
        "locator": "PDF pages 13–16; lines 219–281"
      },
      "final_wording": "Supports fever with flank pain or tenderness, vomiting, visible haematuria, pregnancy, diabetes, immunosuppression, and recurrence as prompts only, without automatic urgency or referral output."
