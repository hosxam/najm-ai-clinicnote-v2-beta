        "locator": "scope and recommendations 1.2.1–1.2.2 and 1.4.1"
      },
      "final_wording": "Supports immediate specialist referral for significant acute gastrointestinal bleeding, medicine-cause review, prior endoscopy review, and further assessment when new alarm signs are present."
    },
