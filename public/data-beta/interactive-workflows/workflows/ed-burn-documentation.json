      "exact_locator": {
        "section_id": "dha-burns-i2-mechanism-classification",
        "heading": "Sections 5–7 — mechanisms and burn classification",
        "locator": "pages 7–13; extracted lines 99–210"
      },
      "final_wording": "Supports thermal, scald, electrical, chemical, friction, depth, blistering, redness, pain, site, and mechanism documentation."
    },
    {
      "workflow_id": "ed-burn-documentation",
      "evidence_statement_id": "wave8-ed-burn-documentation--generated-0002",
      "source_id": "dha-burns-issue2-2024",
      "exact_locator": {
        "section_id": "dha-burns-i2-assessment-tbsa",
        "heading": "Section 7 — airway, vital signs, depth, site, size, and total body surface area",
        "locator": "pages 13–16; extracted lines 185–260"
      },
      "final_wording": "Supports airway and inhalation assessment, neurological and neurovascular context, burn site, size or area, depth, blistering, circumferential features, and total-body-surface-area estimation."
    },
    {
      "workflow_id": "ed-burn-documentation",
      "evidence_statement_id": "wave8-ed-burn-documentation--generated-0003",
      "source_id": "dha-burns-issue2-2024",
      "exact_locator": {
        "section_id": "dha-burns-i2-referral-red-flags",
        "heading": "Sections 7–9 — red flags and referral",
        "locator": "pages 16–19; extracted lines 270–300"
      },
      "final_wording": "Supports escalation for face or neck and airway involvement, inhalation, chemical or electrical burns, circumferential or deep burns, large surface area, special sites, comorbidity, infection, or associated trauma."
    },
    {
      "workflow_id": "ed-burn-documentation",
      "evidence_statement_id": "wave8-ed-burn-documentation--generated-0004",
      "source_id": "dha-burns-issue2-2024",
      "exact_locator": {
        "section_id": "dha-burns-i2-management-followup",
        "heading": "Sections 8–9 — clinician-led burn care, dressing, analgesia, tetanus, monitoring, and follow-up",
        "locator": "pages 18–23; extracted lines 289–370"
      },
      "final_wording": "Supports clinician-documented burn-care discussion, dressing, analgesia, tetanus, return precautions, infection monitoring, arranged follow-up, and referral without autonomous treatment or dose selection."
